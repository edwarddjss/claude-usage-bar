{
  "name": "headroom",
  "displayName": "Headroom",
  "description": "Claude Code and Codex headroom in your VS Code/Cursor status bar.",
  "version": "1.2.17",
  "publisher": "edwarddjss",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edwarddjss/claude-usage-bar"
  },
  "bugs": {
    "url": "https://github.com/edwarddjss/claude-usage-bar/issues"
  },
  "homepage": "https://github.com/edwarddjss/claude-usage-bar#readme",
  "qna": "https://github.com/edwarddjss/claude-usage-bar/issues",
  "keywords": [
    "claude",
    "claude code",
    "claude usage",
    "claude rate limit",
    "claude status bar",
    "codex",
    "openai codex",
    "codex usage",
    "codex rate limit",
    "codex status bar",
    "cursor",
    "cursor extension",
    "usage",
    "usage tracker",
    "status bar",
    "ai",
    "ai coding",
    "ai agent",
    "rate limit",
    "context window",
    "headroom",
    "quota",
    "quota tracker",
    "tokens",
    "usage remaining"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "headroom.openDashboard",
        "title": "Headroom: Open Dashboard",
        "category": "Headroom"
      },
      {
        "command": "headroom.refresh",
        "title": "Headroom: Refresh",
        "category": "Headroom"
      },
      {
        "command": "headroom.copyBridgeSetup",
        "title": "Headroom: Copy Bridge Setup",
        "category": "Headroom"
      },
      {
        "command": "headroom.installBridgeScripts",
        "title": "Headroom: Install Bridge Scripts",
        "category": "Headroom"
      },
      {
        "command": "headroom.openStateFile",
        "title": "Headroom: Open Claude State File",
        "category": "Headroom"
      },
      {
        "command": "headroom.openCodexStateFile",
        "title": "Headroom: Open Codex State File",
        "category": "Headroom"
      }
    ],
    "configuration": {
      "title": "Headroom",
      "properties": {
        "headroom.claudeStatePath": {
          "type": "string",
          "default": "~/.ai-usage-bridge/claude.json",
          "description": "Path to the Claude bridge state JSON file."
        },
        "headroom.codexStatePath": {
          "type": "string",
          "default": "~/.ai-usage-bridge/codex.json",
          "description": "Path to the Codex bridge state JSON file."
        },
        "headroom.statePath": {
          "type": "string",
          "default": "~/.claude-usage-bridge/state.json",
          "description": "Legacy Claude state path used as a fallback."
        },
        "headroom.claudeIdeLockDir": {
          "type": "string",
          "default": "~/.claude/ide",
          "description": "Directory containing Claude Code IDE lock files for workspace activity detection."
        },
        "headroom.displayMode": {
          "type": "string",
          "enum": [
            "auto",
            "claude",
            "codex",
            "both"
          ],
          "default": "auto",
          "description": "Which sources to show. Auto shows a split view when both Claude and Codex have data."
        },
        "headroom.activeThresholdMs": {
          "type": "number",
          "default": 15000,
          "minimum": 3000,
          "description": "How recently a bridge file must have updated to count as live."
        },
        "headroom.primaryMetric": {
          "type": "string",
          "enum": [
            "fiveHour",
            "sevenDay",
            "context"
          ],
          "default": "fiveHour",
          "description": "Which remaining headroom metric to show in the status bar."
        },
        "headroom.statusBarAlignment": {
          "type": "string",
          "enum": [
            "right",
            "left"
          ],
          "default": "right",
          "description": "Status bar alignment."
        },
        "headroom.refreshIntervalMs": {
          "type": "number",
          "default": 500,
          "minimum": 250,
          "description": "How often to refresh the status bar for countdowns (milliseconds)."
        },
        "headroom.barWidth": {
          "type": "number",
          "default": 8,
          "minimum": 4,
          "maximum": 20,
          "description": "Number of characters in the progress bar."
        },
        "headroom.showIcon": {
          "type": "boolean",
          "default": true,
          "description": "Show a codicon before the status bar text."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "pnpm run compile && vsce package --no-dependencies",
    "test": "pnpm run compile && node --test test/*.test.js",
    "lint": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.26.0",
    "typescript": "^5.5.0"
  }
}
